BOT_TOKEN=8933261526:AAFk9HXXdxv4uwZ6DK67KhOdFE4UPF72JSg

# The channel the bot posts to. Must be a channel where the bot is an admin.
# Use @your_channel_username, or the numeric chat id (e.g. -1001234567890)
CHANNEL_ID=@HighPayingRemoteJobs

# How often to check for new jobs, in minutes. Default: 15.
CHECK_INTERVAL_MINUTES=1500

# Optional: comma-separated keywords to filter jobs by title/tags (case-insensitive).
# Leave empty to post everything. Example: react,node,frontend
KEYWORDS=react,node,full stack,fullstack,remote,developer,engineer,programmer,software,webdeveloper

# Optional: comma-separated tags/keywords to EXCLUDE (case-insensitive).
EXCLUDE_KEYWORDS=creative,aspired,inspired,design,designer,marketing,manager,internship,intern,entry-level,junior,senior,lead,principal
